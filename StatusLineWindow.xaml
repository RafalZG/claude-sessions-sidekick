<Window x:Class="ClaudeSessionsSidekick.StatusLineWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Status Line"
        Width="640" Height="520"
        MinWidth="560" MinHeight="460"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E2E"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#3A3A5A"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#40606080"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4A4A6A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BlockButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="PresetButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Claude Code Status Line" FontSize="15" FontWeight="Bold"
                   Foreground="#A0B0FF" Margin="0,0,0,4"/>
        <TextBlock Grid.Row="1" FontSize="11" Foreground="#888899" TextWrapping="Wrap" Margin="0,0,0,12"
                   Text="The line Claude Code shows at the bottom of the terminal. Build it from blocks below — Apply writes a small script and points ~/.claude/settings.json at it."/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,2">
            <TextBlock Text="Presets:" FontSize="11" Foreground="#888899"
                       VerticalAlignment="Center" Margin="0,0,8,6"/>
            <WrapPanel x:Name="pnlPresets"/>
        </StackPanel>

        <!-- MaxLength mirrors StatusLineTemplate.MaxTemplateLength; drift is harmless
             because InsertAtCaret and the script generator both guard with the constant. -->
        <TextBox x:Name="txtTemplate" Grid.Row="3"
                 Background="#15151F" Foreground="#E0E0E0" BorderBrush="#40606080"
                 BorderThickness="1" Padding="8,6" FontSize="13" FontFamily="Consolas"
                 MaxLength="500"
                 TextChanged="TxtTemplate_TextChanged"
                 SpellCheck.IsEnabled="False"/>

        <StackPanel Grid.Row="4" Margin="0,10,0,2">
            <TextBlock Text="Blocks (click to insert):" FontSize="11" Foreground="#888899" Margin="0,0,0,6"/>
            <WrapPanel x:Name="pnlBlocks"/>
        </StackPanel>

        <StackPanel Grid.Row="5" Margin="0,8,0,0">
            <TextBlock Text="Preview (sample data):" FontSize="11" Foreground="#888899" Margin="0,0,0,4"/>
            <Border Background="#101018" BorderBrush="#40606080" BorderThickness="1"
                    CornerRadius="3" Padding="10,7">
                <TextBlock x:Name="txtPreview" FontFamily="Consolas" FontSize="13"
                           Foreground="#C0C8D8" TextTrimming="CharacterEllipsis"/>
            </Border>
        </StackPanel>

        <TextBlock x:Name="txtStatus" Grid.Row="6" FontSize="11" Foreground="#888899"
                   TextWrapping="Wrap" Margin="0,10,0,0"/>

        <TextBlock Grid.Row="7" FontSize="11" Foreground="#606070" TextWrapping="Wrap"
                   VerticalAlignment="Bottom" Margin="0,10,0,0"
                   Text="No restart needed: Apply updates the command entry in settings.json, which makes open Claude Code sessions refresh the status line immediately; new sessions always get it."/>

        <DockPanel Grid.Row="8" Margin="0,12,0,0" LastChildFill="False">
            <Button x:Name="btnRemove" DockPanel.Dock="Left" Content="Remove status line"
                    Click="BtnRemove_Click"
                    Background="#5A3A3A" Foreground="#F0C0C0" BorderBrush="#604040"/>
            <Button Content="Close" DockPanel.Dock="Right" Click="BtnClose_Click" Margin="8,0,0,0"/>
            <Button x:Name="btnApply" DockPanel.Dock="Right" Content="Apply"
                    Click="BtnApply_Click" FontWeight="SemiBold"
                    Background="#3A5A3A" Foreground="#C0F0C0" BorderBrush="#406040"/>
        </DockPanel>
    </Grid>
</Window>
